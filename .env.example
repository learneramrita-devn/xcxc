# API Configuration
VITE_API_BASE_URL=https://api.travelapp.com
VITE_API_TIMEOUT=30000
VITE_TENANT_ID=1

# Environment
VITE_ENV=production

# Analytics (Optional)
VITE_GA_TRACKING_ID=
VITE_GTM_ID=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Security
VITE_ENABLE_RATE_LIMITING=true
VITE_MAX_LOGIN_ATTEMPTS=5

# IMPORTANT: Never commit actual .env file with real credentials
# Copy this file to .env and add your actual values
